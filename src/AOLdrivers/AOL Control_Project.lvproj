            <RelativeToLabVIEW>..\..\..\Program Files (x86)\National Instruments\Shared\FlexRIO\IO Modules\NI 5772\14.0.0\V5\Ni5772\LvFpgaTarget\Ni5772.xml</RelativeToLabVIEW>
